        <related_term rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jaccard index</related_term>
        <related_term rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sørensen-Dice coefficient</related_term>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Intersection analysis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Overlap quantification</oboInOwl:hasExactSynonym>
        <rdfs:label>Overlap analysis</rdfs:label>
    </owl:Class>
    


