        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Is this needed, in addition to http://edamontology.org/topic______Sample_fixation ??</skos:editorialNote>
    </owl:Class>
    


    <!-- http://edamontology.org/topic__RBZsLMTdyuEDtVe2fge61l0 -->

    <owl:Class rdf:about="http://edamontology.org/topic__RBZsLMTdyuEDtVe2fge61l0">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_0611"/>
        <related_term rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Scanning electron microscope</related_term>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In scanning electron microscopy, a focused beam of electrons is raster scanned over the surface of the sample. The image is typically formed by detecting secondary electrons or backscattered electrons.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SEM</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:label>Scanning electron microscopy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://bioportal.bioontology.org/ontologies/MESH/?p=classes&amp;conceptid=http%3A%2F%2Fpurl.bioontology.org%2Fontology%2FMESH%2FD008855"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Scanning_electron_microscope"/>
    </owl:Class>
    


    <!-- http://edamontology.org/topic__RBfI2XgIsxcfKonPPluKAhK -->

    <owl:Class rdf:about="http://edamontology.org/topic__RBfI2XgIsxcfKonPPluKAhK">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_3382"/>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spectroscopy refers to the study of how radiated energy and matter interact. The energy is absorbed by the matter, creating an excited state. The interaction creates some form of electromagnetic waves (EM), often in the form of visible light, such as sparks.

Spectrometry deals with the measurement of a specific spectrum; essentially the application of spectroscopy so that there are quantifiable results that can then be assessed.</oboInOwl:hasDefinition>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spectrometry</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:label>Spectroscopy</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Spectroscopy"/>
    </owl:Class>
    


    <!-- http://edamontology.org/topic__RBkRgSi7js0c70kjiPgYTgR -->

    <owl:Class rdf:about="http://edamontology.org/topic__RBkRgSi7js0c70kjiPgYTgR">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_3452"/>
        <oboInOwl:hasRelatedSynonym>SPECT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:label>Single-photon emission computed tomography</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Single-photon_emission_computed_tomography"/>
    </owl:Class>
    


    <!-- http://edamontology.org/topic__RBsSZve5PnQFO3scMDWo9f0 -->

    <owl:Class rdf:about="http://edamontology.org/topic__RBsSZve5PnQFO3scMDWo9f0">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_3385"/>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Array detector microscopy</oboInOwl:hasExactSynonym>
