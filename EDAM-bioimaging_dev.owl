    <!-- http://edamontology.org/topic_4010 -->

    <owl:Class rdf:about="http://edamontology.org/topic_4010">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_0003"/>
        <created_in>1.26</created_in>
        <oboInOwl:hasBroadSynonym>Open and reliable science</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>Open research</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>Open, reliable, transparent, and trustable science</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Open science encompasses the practices of making scientific research transparent and participatory, and its outputs publicly accessible.</oboInOwl:hasDefinition>
