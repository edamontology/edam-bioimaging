    <!-- http://edamontology.org/operation____Top-hat_transform -->

    <owl:Class rdf:about="http://edamontology.org/operation____Top-hat_transform">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_Morphological_operations"/>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hat transform</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Top-hat transform is a morphological operation computed by subtracting the opened image from the original input image. It is used to extract small elements and details from given images.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">White top-hat transform</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Black top-hat transform</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bottom-hat transform</oboInOwl:hasRelatedSynonym>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The bottom-hat transform: the residual of a closing compared to the original image.</rdfs:comment>
        <rdfs:label>Top-hat transform</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Top-hat_transform"/>
    </owl:Class>
    


