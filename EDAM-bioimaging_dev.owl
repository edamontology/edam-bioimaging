    <!-- http://edamontology.org/data_Image -->

    <owl:Class rdf:about="http://edamontology.org/data_Image">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/data_0006"/>
        <_permanent_id rdf:resource="http://edamontology.org/data_2968"/>
        <created_in rdf:datatype="http://www.w3.org/2001/XMLSchema#string">beta12orEarlier</created_in>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spatial data</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Data (typically biological or biomedical) that has been rendered into an image, typically for display on screen.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>Image</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Digital image</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Image set</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pixel-based image</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Raster image</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Set of images</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Voxel-based image</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/data"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <rdfs:label>Image data</rdfs:label>
        <skos:editorialNote>So far consensus: Primary term Image data, exact synonym Image, meaning image or a set of (related) images (forming e.g. a stack or a time lapse). No synonyms for stacks and &quot;movies&quot;, these should be specialised concepts.</skos:editorialNote>
        <skos:narrowMatch rdf:resource="http://semanticscience.org/resource/SIO_000081"/>
    </owl:Class>
    


