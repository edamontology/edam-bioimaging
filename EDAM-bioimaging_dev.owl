    <!-- http://edamontology.org/topic__RxfmHE99gOkUOOML5krfsJ -->

    <owl:Class rdf:about="http://edamontology.org/topic__RxfmHE99gOkUOOML5krfsJ">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_3452"/>
        <oboInOwl:hasExactSynonym>CAT scan</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>CT</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>CT scan</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Computerised axial tomography</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HRCT</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">High-resolution CT</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">High-resolution micro-CT</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">X-ray computed tomography</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">High-resolution X-ray tomography</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">X-ray tomography</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CT is usually understood as X-ray CT (https://en.wikipedia.org/wiki/X-ray_computed_tomography redirecting to https://en.wikipedia.org/wiki/CT_scan). On the other hand, Optical tomography can also be CT, see concept Optical projection tomography with its synonyms.</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Work comment: Radical but perhaps a good consideration is to move CT as a narrow synonym of Tomography.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Computed tomography</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/CT_scan"/>
    </owl:Class>
    


