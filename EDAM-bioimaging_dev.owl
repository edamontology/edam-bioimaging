        <oboInOwl:hasNarrowSynonym>Query</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/operations"/>
        <rdfs:label>Query and retrieval</rdfs:label>
    </owl:Class>
    


    <!-- http://edamontology.org/operation_0226 -->

    <owl:Class rdf:about="http://edamontology.org/operation_0226">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_0004"/>
        <created_in>beta12orEarlier</created_in>
        <hide_in_subset rdf:resource="http://edamontology.org/imaging"/>
        <notRecommendedForAnnotation rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</notRecommendedForAnnotation>
