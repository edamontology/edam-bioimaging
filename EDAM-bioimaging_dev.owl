    <!-- http://edamontology.org/topic_______Multiplexed_immunohistochemistry -->

    <owl:Class rdf:about="http://edamontology.org/topic_______Multiplexed_immunohistochemistry">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_______Tissue_imaging"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_______Immunostaining"/>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Co-detection by indexing (CODEX)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cytometry by cyclic immunofluorescence (CyCIF)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multiplexed immunofluorescence</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Multiplexed immunohistochemistry</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vectra imaging?/ Vectra cytometry?</oboInOwl:hasNarrowSynonym>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Note that imaging mass cytometry (IMC, ADD EDAM ID HERE) is a special case of multiplexed immunostaining, distinct from both (multiplexed) immunofluorenscence
 and immunohistochemistry (IHC).</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multiplexed immunostaining</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Immunostaining"/>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Other than CyCIF and CODEX, this includes also other machines, such as Vectra, DISCOVERY ULTRA, InSituPlex, DSP, Chipcytometry.</skos:editorialNote>
    </owl:Class>
    


