    <!-- http://edamontology.org/topic_____Micro-optical_sectioning_tomography -->

    <owl:Class rdf:about="http://edamontology.org/topic_____Micro-optical_sectioning_tomography">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_3452"/>
        <related_term rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Holography</related_term>
        <related_term rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Structured illumination</related_term>
