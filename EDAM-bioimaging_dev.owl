        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/operations"/>
        <rdfs:label>Image deconvolution</rdfs:label>
    </owl:Class>
    


    <!-- http://edamontology.org/operation_Image_enhancement -->

    <owl:Class rdf:about="http://edamontology.org/operation_Image_enhancement">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_Image_processing"/>
        <oboInOwl:hasNarrowSynonym>Image restoration</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/operations"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Image enhancement is a term used to refer to an operation that increases the quality of the image, being historically more used in the context of contrast enhancement (which improves visualization for the human eye). However, image enhancement is also a very general term that refers to operations that enhance features interest in the image. An image enhancement operation moves further away from the &quot;reality&quot;, as opposed to Image reconstruction that moves closer to the &quot;reality&quot;.</rdfs:comment>
        <rdfs:label>Image enhancement</rdfs:label>
    </owl:Class>
    


    <!-- http://edamontology.org/operation_Image_processing -->

    <owl:Class rdf:about="http://edamontology.org/operation_Image_processing">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_0004"/>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Image transformation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Image filtering</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Image post-processing</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Image postprocessing</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Image pre-processing</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Image preprocessing</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Image manipulation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/operations"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Image processing</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Digital_image_processing"/>
    </owl:Class>
    


    <!-- http://edamontology.org/operation_Image_reconstruction -->

    <owl:Class rdf:about="http://edamontology.org/operation_Image_reconstruction">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_Image_processing"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation__RDFFD5jBfUw74a3vJeBAGB1"/>
        <oboInOwl:hasNarrowSynonym>Image restoration</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/operations"/>
        <rdfs:comment>Image enhancement moves further away from the &quot;reality&quot;, as opposed to Image reconstruction that moves closer to the &quot;reality&quot;.</rdfs:comment>
        <rdfs:label>Image reconstruction</rdfs:label>
    </owl:Class>
    


    <!-- http://edamontology.org/operation_Image_registration -->

    <owl:Class rdf:about="http://edamontology.org/operation_Image_registration">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_2928"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_Image_processing"/>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Image overlay</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Image registration is the process of aligning, by applying geometric transformation, two or more misaligned images.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>Image alignment</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/operations"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Registration is necessary in order to be able to compare or integrate the data obtained from different sensors/imaging modalities, at different times, from different view points, etc.

Registration can  be based on correspondence established between the landmarks or feature points. Alternatively, some similarity/distance metric is established between the image intensity maps to navigate the registration process.</rdfs:comment>
        <rdfs:label>Image registration</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Image_registration"/>
    </owl:Class>
    


    <!-- http://edamontology.org/operation_Image_segmentation -->

    <owl:Class rdf:about="http://edamontology.org/operation_Image_segmentation">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_3443"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_Image_processing"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/operations"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Image segmentation is (one of) the (few) concept(s) on the border between Image (pre)processing (Image-&gt;Image) and Image analysis (Image-&gt;Data).</rdfs:comment>
        <rdfs:label>Image segmentation</rdfs:label>
    </owl:Class>
    


