        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Machine learning-based data generation</rdfs:label>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">delete BUT SAVE COMMENTS FIRST!</skos:editorialNote>
