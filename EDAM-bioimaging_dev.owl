        </rdfs:subClassOf>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MCFoell</oboInOwl:created_by>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-01-17T08:44:37.897393Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ion image normalisation is normalising mass spectra intensities of mass spectrometry imaging data.</oboInOwl:hasDefinition>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ion image normalisation</rdfs:label>
    </owl:Class>
    


    <!-- http://edamontology.org/operations________003 -->

    <owl:Class rdf:about="http://edamontology.org/operations________003">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_Image_segmentation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://edamontology.org/has_topic"/>
                <owl:someValuesFrom rdf:resource="http://edamontology.org/topic_____Mass_spectrometry_imaging"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MCFoell</oboInOwl:created_by>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-01-17T08:55:29.694009Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ion image segmentation is the spatial segmentation of a single (univariate) or multiple (multivariate) m/z feature(s) in mass spectrometry imaging data.</oboInOwl:hasDefinition>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Typically performed in an unsupervised way and for visual analysis and comparison with histology images.</rdfs:comment>
        <rdfs:label>Ion image segmentation</rdfs:label>
    </owl:Class>
    


    <!-- http://edamontology.org/operations________004 -->

    <owl:Class rdf:about="http://edamontology.org/operations________004">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operations________003"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://edamontology.org/has_topic"/>
                <owl:someValuesFrom rdf:resource="http://edamontology.org/topic_____Mass_spectrometry_imaging"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MCFoell</oboInOwl:created_by>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-01-17T08:57:23.072682Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Univariate ion image segmentation is the spatial segmentation of a single (univariate) m/z feature in mass spectrometry imaging data.</oboInOwl:hasDefinition>
        <rdfs:label>Univariate ion image segmentation</rdfs:label>
    </owl:Class>
    


    <!-- http://edamontology.org/operations________005 -->

    <owl:Class rdf:about="http://edamontology.org/operations________005">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operations________003"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://edamontology.org/has_topic"/>
                <owl:someValuesFrom rdf:resource="http://edamontology.org/topic_____Mass_spectrometry_imaging"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MCFoell</oboInOwl:created_by>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-01-17T08:58:23.552733Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multivariate ion image segmentation is the spatial segmentation of multiple (multivariate) m/z features in mass spectrometry imaging data.</oboInOwl:hasDefinition>
        <rdfs:label>Multivariate ion image segmentation</rdfs:label>
    </owl:Class>
    


    <!-- http://edamontology.org/operations________006 -->

    <owl:Class rdf:about="http://edamontology.org/operations________006">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_Pixel_classification"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://edamontology.org/has_topic"/>
                <owl:someValuesFrom rdf:resource="http://edamontology.org/topic_____Mass_spectrometry_imaging"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MCFoell</oboInOwl:created_by>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-01-17T09:05:25.884957Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ion image pixel classification is classifying mass spectra (i.e. pixels) of mass spectrometry imaging data.</oboInOwl:hasDefinition>
        <rdfs:label>Ion image pixel classification</rdfs:label>
    </owl:Class>
    


    <!-- http://edamontology.org/operations________007 -->

    <owl:Class rdf:about="http://edamontology.org/operations________007">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_Image_classification"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://edamontology.org/has_topic"/>
                <owl:someValuesFrom rdf:resource="http://edamontology.org/topic_____Mass_spectrometry_imaging"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MCFoell</oboInOwl:created_by>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-01-17T09:11:03.686925Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ion image classification is classifying entire samples (typically tissues) measured by mass spectrometry imaging.</oboInOwl:hasDefinition>
        <rdfs:label>Ion image classification</rdfs:label>
    </owl:Class>
    


    <!-- http://edamontology.org/operations________008 -->

    <owl:Class rdf:about="http://edamontology.org/operations________008">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation___Pixel-based_colocalisation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://edamontology.org/has_topic"/>
                <owl:someValuesFrom rdf:resource="http://edamontology.org/topic_____Mass_spectrometry_imaging"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MCFoell</oboInOwl:created_by>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-01-17T09:15:33.096126Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ion image colocalisation analysis aims to find m/z features with similar spatial distributions (=colocalisation) by correlating the intensity of m/z features across all the ion images collected for a mass spectrometry imaging dataset.</oboInOwl:hasDefinition>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Typically uses a reference m/z feature or a defined region (e.g. segment) and searches for m/z features with similar spatial distribution (=colocalisation).</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ion image colocalisation analysis</rdfs:label>
    </owl:Class>
    


    <!-- http://edamontology.org/operations________009 -->

    <owl:Class rdf:about="http://edamontology.org/operations________009">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_3434"/>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Matúš Kalaš, Leonid Kostrykin</oboInOwl:created_by>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-06-17T13:30:31.715401Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rasterisation is the operation of converting spatial data from a vector representation (format) to a raster representation (format).</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>Vector-to-raster conversion</oboInOwl:hasExactSynonym>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Although typically defined for images or computer graphics, rasterisation can in principle apply to any spatial data (i.e. data with 2 or more dimensions within a metric/Euclidean space).</rdfs:comment>
        <rdfs:label>Rasterisation</rdfs:label>
        <rdfs:label xml:lang="en-us">Rasterization</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Rasterisation"/>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TODO Spatial data: Only &quot;digital&quot; spatial data? And what does digital mean exactly? (And does it have to be a metric space?) Apply all these concerns to the future definition of Spatial data, and related concepts. NOTE wikipedia/wikidata only about computer graphics or in the best case images, but otherwise it&apos;s really exactMatches for both rasterisation and vectorisation. TODO somehow add references to Vector/Raster formats (a complex owl:Restriction?).</skos:editorialNote>
        <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q14524612"/>
    </owl:Class>
    


    <!-- http://edamontology.org/operations________010 -->

    <owl:Class rdf:about="http://edamontology.org/operations________010">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_3434"/>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Matúš Kalaš, Leonid Kostrykin</oboInOwl:created_by>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-06-17T21:00Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vectorisation is the operation of converting spatial data from a raster representation (format) to a vector representation (format).</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>Image tracing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Raster vectorisation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Raster-to-vector conversion</oboInOwl:hasExactSynonym>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Although typically defined for images and computer graphics, vectorisation can in principle apply to any spatial data (i.e. data with 2 or more dimensions within a metric/Euclidean space).</rdfs:comment>
        <rdfs:label>Vectorisation</rdfs:label>
        <rdfs:label xml:lang="en-us">Vectorization</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Image_tracing"/>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TODO Spatial data: See note in the Rasterisation operation concept. TODO somehow add references to Vector/Raster formats (a complex owl:Restriction?).</skos:editorialNote>
        <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q265186"/>
    </owl:Class>
    


    <!-- http://edamontology.org/operations________011 -->

    <owl:Class rdf:about="http://edamontology.org/operations________011">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_Fluorescent_microscopy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://edamontology.org/can_use"/>
                <owl:someValuesFrom rdf:resource="http://edamontology.org/topic_Super-resolution_microscopy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://edamontology.org/can_use"/>
                <owl:someValuesFrom rdf:resource="http://edamontology.org/topic_Widefield_microscopy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://edamontology.org/can_use"/>
                <owl:someValuesFrom rdf:resource="http://edamontology.org/topic__R9Cmje2ZUXyDW6aQAvFhwSM"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <abbreviation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FISH</abbreviation>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Caterina Strambio De Castillia,  Sarah Aumfkolk, Irene Farabella, Iago Macedo Porto</oboInOwl:created_by>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-09-02T13:18:49.484735Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Fluorescence microscopy technique in which specific DNA and RNA target sequences are visualized in individual cells or whole tissues using fluorescently labeled oligonucleotide-based probes.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fluorescence In-Situ Hybridization</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fluorescence in-situ hybridisation</oboInOwl:hasExactSynonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fluorescence in situ hybridisation</rdfs:label>
        <rdfs:label xml:lang="en-us">Fluorescence in situ hybridization</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Fluorescence_in_situ_hybridization"/>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TODO add contributors!</skos:editorialNote>
        <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q1336182"/>
    </owl:Class>
    


    <!-- http://edamontology.org/operations________012 -->

    <owl:Class rdf:about="http://edamontology.org/operations________012">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topics________049"/>
        <abbreviation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BAS CT</abbreviation>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Caterina Strambio De Castillia,  Sarah Aumfkolk, Irene Farabella, Iago Macedo Porto</oboInOwl:created_by>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-09-02T13:28:05.857191Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A chromatin tracing technique in which each targeted genomic segment is visualised as an estimated three-dimensional position of a detected fluorescent signal.</oboInOwl:hasDefinition>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ball-and-stick chromatin tracing</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://doi.org/10.1016/j.molcel.2023.06.018"/>
    </owl:Class>
    


    <!-- http://edamontology.org/operations________013 -->

    <owl:Class rdf:about="http://edamontology.org/operations________013">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topics________049"/>
        <abbreviation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VOL CT</abbreviation>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Caterina Strambio De Castillia,  Sarah Aumfkolk, Irene Farabella, Iago Macedo Porto</oboInOwl:created_by>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-09-02T13:28:24.984794Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A chromatin tracing technique in which each targeted genomic segment is visualised as a cloud of fluorescence localisations representing its overall shape.</oboInOwl:hasDefinition>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Volumetric chromatin tracing</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://doi.org/10.1016/j.molcel.2023.06.018"/>
    </owl:Class>
    


    <!-- http://edamontology.org/operations________014 -->

    <owl:Class rdf:about="http://edamontology.org/operations________014">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operations________011"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_3383"/>
        <abbreviation>Multiplexed FISH</abbreviation>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Caterina Strambio De Castillia,  Sarah Aumfkolk, Irene Farabella, Iago Macedo Porto</oboInOwl:created_by>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-09-24T16:28:14.201807Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fluorescence in-situ hybridisation (FISH) technique that detects multiple, and ideally all, DNA or RNA target sequences within individual cells or whole tissues through sequential rounds of probe hybridisation, imaging, and probe removal or inactivation.</oboInOwl:hasDefinition>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FISH omics</oboInOwl:hasRelatedSynonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multiplexed fluorescence in situ hybridisation</rdfs:label>
        <rdfs:label xml:lang="en-us">Multiplexed fluorescence in situ hybridization</rdfs:label>
    </owl:Class>
    


    <!-- http://edamontology.org/topic_0003 -->

    <owl:Class rdf:about="http://edamontology.org/topic_0003">
        <created_in>beta12orEarlier</created_in>
        <notRecommendedForAnnotation rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</notRecommendedForAnnotation>
        <oboInOwl:hasDefinition>A category denoting a rather broad domain or field of interest, of study, application, work, data, or technology. Topics have no clearly defined borders between each other.</oboInOwl:hasDefinition>
        <oboInOwl:hasNarrowSynonym>Field of Study</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <oboInOwl:inSubset rdf:resource="http:/edamontology.org/imaging"/>
        <rdfs:label>Topic</rdfs:label>
        <skos:broadMatch rdf:resource="http://onto.eva.mpg.de/ontologies/gfo-bio.owl#Method"/>
        <skos:broadMatch rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <skos:broadMatch rdf:resource="http://www.onto-med.de/ontologies/gfo.owl#Category"/>
        <skos:broadMatch rdf:resource="http://www.onto-med.de/ontologies/gfo.owl#Perpetuant"/>
        <skos:closeMatch rdf:resource="http://bioontology.org/ontologies/ResearchArea.owl#Area_of_Research"/>
        <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <skos:relatedMatch rdf:resource="http://purl.org/biotop/biotop.owl#Quality"/>
        <skos:relatedMatch rdf:resource="http://www.loa.istc.cnr.it/ontologies/DOLCE-Lite.owl#quality"/>
    </owl:Class>
    


    <!-- http://edamontology.org/topic_0134 -->

    <owl:Class rdf:about="http://edamontology.org/topic_0134">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_______Spectrometry"/>
        <created_in>beta12orEarlier</created_in>
        <oboInOwl:hasDefinition>An analytical chemistry technique that measures the mass-to-charge ratio and abundance of ions in the gas phase.</oboInOwl:hasDefinition>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:label>Mass spectrometry</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Mass_spectrometry"/>
        <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q180809"/>
    </owl:Class>
    


    <!-- http://edamontology.org/topic_0218 -->

    <owl:Class rdf:about="http://edamontology.org/topic_0218">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic______Artificial_intelligence"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topics________045"/>
        <created_in>beta12orEarlier</created_in>
        <oboInOwl:hasDefinition>The processing and analysis of natural language, such as scientific literature in English, in order to extract data and information, or to enable human-computer interaction.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>NLP</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>BioNLP</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Literature mining</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Text analytics</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Text data mining</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Text mining</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:label>Natural language processing</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Biomedical_text_mining"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Natural_language_processing"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Text_mining"/>
    </owl:Class>
    


    <!-- http://edamontology.org/topic_0219 -->

    <owl:Class rdf:about="http://edamontology.org/topic_0219">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_3071"/>
        <created_in>beta12orEarlier</created_in>
        <related_term>Data archive</related_term>
        <related_term>Data library</related_term>
        <related_term>Data provenance</related_term>
        <related_term>Data registry</related_term>
        <related_term>Data repository</related_term>
        <related_term>Data storage</related_term>
        <related_term>Deposition database</related_term>
        <related_term>Research data archive</related_term>
        <related_term>Research data repository</related_term>
        <oboInOwl:hasDefinition>Data curation and archival includes the preservation of data in a repository, archive, or a deposition database; and curation of data and metadata, database accessions, annotation, and data provenance.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>Data archival</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Data archiving</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Data curation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Data preservation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>Database curation</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Research data archiving</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <oboInOwl:savedBy>2023-02-24T10:59:23.548411Z, erihje</oboInOwl:savedBy>
        <oboInOwl:savedBy>2024-09-16, bianchini</oboInOwl:savedBy>
        <oboInOwl:savedBy>2024-09-23, Matúš Kalaš</oboInOwl:savedBy>
        <rdfs:comment>Note that biocuration is a more specific concept than simply curation and archival of bioscientific data.</rdfs:comment>
        <rdfs:comment>The purpose of data curation and preservation is ensuring permanent access to the data and enabling its future analysis. Enabling reanalysis of the data in unexpected future contexts requires that the data is findable and reusable (see also FAIR data, topic_4012).</rdfs:comment>
        <rdfs:label>Data curation and archival</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Data_curation"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Data_preservation"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Research_data_archiving"/>
        <skos:editorialNote>TODO: Add Biocuration! Look at and deal with https://en.wikipedia.org/wiki/Digital_curation! And perhaps other from the many concepts within the broad https://en.wikipedia.org/wiki/Digital_preservation (currently in operation_4043)! Probably somehow add Digital library (https://www.wikidata.org/wiki/Q212805) or/and related concepts. Within https://en.wikipedia.org/wiki/Library_science and https://en.wikipedia.org/wiki/Archival_science. Maybe generic archive (https://en.wikipedia.org/wiki/Archive, archiving=https://www.wikidata.org/wiki/Q10418049, and curating=https://www.wikidata.org/wiki/Q63386008)? Preservation is something else, but consider (https://www.wikidata.org/wiki/Q1479406)? And less related, but should we consider https://en.wikipedia.org/wiki/Data_integrity,https://en.wikipedia.org/wiki/File_fixity?</skos:editorialNote>
        <skos:editorialNote>TODO: Add skos:related to Open science (this isn&apos;t only science), FAIR data, and Digitalisation (esp. from there to here?). Perhaps more, see a separate editorialNote.</skos:editorialNote>
        <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q15088675"/>
        <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q48797981"/>
        <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q65769313"/>
        <skos:narrowMatch rdf:resource="https://www.wikidata.org/wiki/Q17155735"/>
        <skos:relatedMatch rdf:resource="https://www.wikidata.org/wiki/Q5227240"/>
    </owl:Class>
    


    <!-- http://edamontology.org/topic_0593 -->

    <owl:Class rdf:about="http://edamontology.org/topic_0593">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic__RBfI2XgIsxcfKonPPluKAhK"/>
        <abbreviation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NMR spectroscopy</abbreviation>
        <created_in>beta12orEarlier</created_in>
        <oboInOwl:hasDefinition>Nuclear magnetic resonance (NMR) spectroscopy is an analytical technique that utilises the magenetic properties of certain atomic nuclei to provide information on the structure, dynamics, reaction state, and chemical environment of molecules.</oboInOwl:hasDefinition>
        <oboInOwl:hasNarrowSynonym>Heteronuclear Overhauser Effect Spectroscopy (HOESY)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Magnetic resonance spectroscopy (MRS)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Nuclear Overhauser Effect Spectroscopy (NOESY)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Rotational Frame Nuclear Overhauser Effect Spectroscopy (ROESY)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:label>Nuclear magnetic resonance spectroscopy</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Nuclear_magnetic_resonance_spectroscopy"/>
    </owl:Class>
    


    <!-- http://edamontology.org/topic_0611 -->

    <owl:Class rdf:about="http://edamontology.org/topic_0611">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_Microscopy"/>
        <created_in>beta12orEarlier</created_in>
        <related_term rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electron microscope</related_term>
        <oboInOwl:hasDefinition>Electron microscopy is any form of microscopy that uses a beam of accelerated electrons to image a sample. Electron microscopes can image at higher resolution than light microscopy due to the smaller de Broglie wavelength of the electrons.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EM</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:label>Electron microscopy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://bioportal.bioontology.org/ontologies/MESH/?p=classes&amp;conceptid=http%3A%2F%2Fpurl.bioontology.org%2Fontology%2FMESH%2FD008855"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Electron_microscope"/>
        <skos:editorialNote>Todo check some old synonyms from EDAM main: Electron diffraction experiment (broad), Electron crystallography, Single particle electron microscopy (both narrow).</skos:editorialNote>
    </owl:Class>
    


