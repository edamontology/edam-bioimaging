    <!-- http://edamontology.org/operation_Watershed -->

    <owl:Class rdf:about="http://edamontology.org/operation_Watershed">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation____Region_growing"/>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Watershed transformation</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Watershed-based segmentation</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/operations"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Needs a comment about the relation between the Watershed and Region growing.</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Watershed is the term that commonly refers to a mathematical morphology operation that treats a grayscale image as a topographic map and segments the image. The segmentation is performed by a succesive &apos;flooding&apos; operation from minima in the image starting from different points and separates the image in different catchment basins.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Watershed segmentation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://edamontology.org/operation_Morphological_operations"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Region_growing"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Watershed_(image_processing)"/>
    </owl:Class>
    


