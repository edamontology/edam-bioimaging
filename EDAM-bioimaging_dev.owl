        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-08-15T20:55:39.352613Z</oboInOwl:creation_date>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">imzML is a conglomerate format consisting of 2 files: .idb (http://edamontology.org/format_3839) and imzML metadata file (.imzML, http://edamontology.org/format_3682).</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">imzML</rdfs:label>
