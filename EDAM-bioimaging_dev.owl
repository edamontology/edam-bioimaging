            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:hasBroadSynonym>Neuron image informatics</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasNarrowSynonym>Connectomics</oboInOwl:hasNarrowSynonym>
