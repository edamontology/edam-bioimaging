    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://edamontology.org/data_0842"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#narrowMatch"/>
        <owl:annotatedTarget rdf:resource="http://purl.org/dc/elements/1.1/identifier"/>
        <rdfs:comment>Almost exact but limited to identifying resources, and being unambiguous.</rdfs:comment>
    </owl:Axiom>
    


