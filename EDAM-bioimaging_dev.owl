    <!-- http://edamontology.org/operation__R9Qf06vxvFj2UbAk7pW3IMG -->

    <owl:Class rdf:about="http://edamontology.org/operation__R9Qf06vxvFj2UbAk7pW3IMG">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_Image_segmentation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#related"/>
                <owl:someValuesFrom rdf:resource="http://edamontology.org/topic_Neuron_image_analysis"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <related_term rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Neuron reconstruction</related_term>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tubular structure extraction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Biofilament tracing</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Curvilinear structure detection</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Curvilinear structure reconstruction</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/operations"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Filament tracing is an image analysis operation which consumes an image of a filamentous structure (it may be a tree-like structure, a filament network or a agglomeration of single &apos;stick-like&apos; filaments), and outputs data that represent the filament(s), most commonly a skeleton representation of the filaments and their diameters or surfaces.</rdfs:comment>
        <rdfs:label>Filament tracing</rdfs:label>
    </owl:Class>
    


