    <owl:Class rdf:about="http://edamontology.org/operation______Connectivity-based_clustering">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation___Clustering"/>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Connectivity-based clustering</oboInOwl:hasExactSynonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hierarchical clustering</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Hierarchical_clustering"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Cluster_analysis#Connectivity-based_clustering_(hierarchical_clustering)"/>
    </owl:Class>
    


    <!-- http://edamontology.org/operation______Data_augmentation -->

    <owl:Class rdf:about="http://edamontology.org/operation______Data_augmentation">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_3429"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://edamontology.org/has_topic"/>
                <owl:someValuesFrom rdf:resource="http://edamontology.org/topic_3474"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Synthetically increasing the multiplicity and diversity of data available without collecting new data. Data augmentation relies on a priori knowledge (e.g. of system invariants or the noise structure of the data) to generate more data, typically for training learning models. Common data augmentation techniques include corruption by artificial noise, cropping, padding, rotation, and flipping.</oboInOwl:hasDefinition>
        <rdfs:label>Data augmentation</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Data_augmentation"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Convolutional_neural_network#Artificial_data"/>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TODO: See also see also in the see also, i.e. https://en.wikipedia.org/wiki/Data_augmentation#See_also</skos:editorialNote>
    </owl:Class>
    


