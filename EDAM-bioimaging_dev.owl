        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Techniques in microscopy in which the sample is placed between the illumination source and the observer or recording device.</oboInOwl:hasDefinition>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Widefield transmission light microscopy</oboInOwl:hasNarrowSynonym>
