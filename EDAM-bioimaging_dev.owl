        <abbreviation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FTIR</abbreviation>
        <rdfs:label>Fourier-transform infrared spectroscopy</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Fourier-transform_infrared_spectroscopy"/>
    </owl:Class>
    


    <!-- http://edamontology.org/topic______High_throughput_screening -->

    <owl:Class rdf:about="http://edamontology.org/topic______High_throughput_screening">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_0003"/>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Highly automated microscopy to image and analyse large areas and/or large number of samples. Also outside of imaging (as opposed to HCA/HCS), e.g. proteomics, gene expression/transcriptomics, etc.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HTS</oboInOwl:hasExactSynonym>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In simple terms, high-content screening (HCS) is the combination of high-throughput screening (HTS) applied to high-content analysis (HCA).</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">High-throughput screening</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/High-throughput_screening"/>
    </owl:Class>
    


