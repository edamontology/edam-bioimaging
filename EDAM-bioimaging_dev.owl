    </owl:Class>
    


    <!-- http://edamontology.org/topics________029 -->

    <owl:Class rdf:about="http://edamontology.org/topics________029">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic________Scanning_probe_microscopy"/>
        <abbreviation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">STM</abbreviation>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bianchini</oboInOwl:created_by>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-08-15T06:54:49.46901Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Scanning tunneling microscopy is a technique  that uses quantum tunneling to image surfaces, often at an atomic level resolution. It works by scanning a sharp tip over a sample&apos;s surface and measuring the resulting tunneling current.</oboInOwl:hasDefinition>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spin-polarised scanning tunneling microscopy (SP-STM)</oboInOwl:hasNarrowSynonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Scanning tunneling microscopy</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Scanning_tunneling_microscope"/>
        <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q71251194"/>
    </owl:Class>
    


