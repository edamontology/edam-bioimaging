    <!-- http://edamontology.org/topic_Statistics -->

    <owl:Class rdf:about="http://edamontology.org/topic_Statistics">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_0003"/>
        <_permanent_id rdf:resource="http://edamontology.org/topic_2269"/>
        <created_in rdf:datatype="http://www.w3.org/2001/XMLSchema#string">beta12orEarlier</created_in>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The application of statistical methods to biological problems.</oboInOwl:hasDefinition>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Biostatistics</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Descriptive statistics</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inferential statistics</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multivariate statistics</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Probability</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Statistics</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:label>Statistics and probability</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://en.wikipedia.org/wiki/Biostatistics"/>
        <rdfs:seeAlso rdf:resource="http://purl.bioontology.org/ontology/MSH/D056808"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Probability"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Statistics"/>
    </owl:Class>
    


    <!-- http://edamontology.org/topic_Super-resolution_microscopy -->

    <owl:Class rdf:about="http://edamontology.org/topic_Super-resolution_microscopy">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_Fluorescent_microscopy"/>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Group of microscopy techniques that circumvent the diffration limit and therefore allow for a greater spatial resolution  limit.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SR microscopy (SRM)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sub-diffraction microscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fluorescence nanoscopy</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">High-resolution microscopy</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optical nanoscopy</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Super-resolution fluorescence microscopy</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">There are rare exceptions of super-resolution microscopy, such as scanning near-field optical microscopy (SNOM), that do not necessarily rely on fluorescence.</rdfs:comment>
        <rdfs:label>Super-resolution microscopy</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Super-resolution_microscopy"/>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enhanced-resolution microscopy is probably included other methods which are not really super-resolution yet. Does that need its concept?</skos:editorialNote>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TODO: review synonyms, and enhanced-resolution concerns.</skos:editorialNote>
    </owl:Class>
    


    <!-- http://edamontology.org/topic_Widefield_microscopy -->

    <owl:Class rdf:about="http://edamontology.org/topic_Widefield_microscopy">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_Fluorescent_microscopy"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic__RBsSZve5PnQFO3scMDWo9f0"/>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Widefield microscopy is a fluorescence microscopy technique in which the entire sample is illuminated concurrently, and the emission is either visualised by an observer, or captured by a camera.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Widefield fluorescence microscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>Epi-fluorescence microscopy</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Epifluorescence microscopy</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Widefield microscopy</rdfs:label>
    </owl:Class>
    


    <!-- http://edamontology.org/topic__R77vfEkRqjIenYUqhDPvdkM -->

    <owl:Class rdf:about="http://edamontology.org/topic__R77vfEkRqjIenYUqhDPvdkM">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic______Sample_fixation"/>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cryo-fixation</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cryofixation</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Cryofixation"/>
    </owl:Class>
    


    <!-- http://edamontology.org/topic__R7LElbFkBgKS401YKsVtNck -->

    <owl:Class rdf:about="http://edamontology.org/topic__R7LElbFkBgKS401YKsVtNck">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_0611"/>
        <related_term rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transmission electron microscope</related_term>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In TEM, a beam of electrons is transmitted through an ultrathin sample (typically less than 100 nm thick). Transmitted electrons interact with the sample and are focused onto an imaging device such as a fluorescent screen, photographic film or camera.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>TEM</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:label>Transmission electron microscopy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://bioportal.bioontology.org/ontologies/MESH/?p=classes&amp;conceptid=http%3A%2F%2Fpurl.bioontology.org%2Fontology%2FMESH%2FD046529"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Transmission_electron_microscopy"/>
    </owl:Class>
    


    <!-- http://edamontology.org/topic__R7Vn7GbwtqVvGWNAMGdcNW1 -->

    <owl:Class rdf:about="http://edamontology.org/topic__R7Vn7GbwtqVvGWNAMGdcNW1">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_3385"/>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Microscopy techniques relying on the point by point imaging of the entire sample. This is typically performed with point illumination of the sample.</oboInOwl:hasDefinition>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4Pi microscopy</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Controlled light exposure microscopy</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Point-scanning microscopy</rdfs:label>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IS IT Point-scanning microscopy OR Point illumination microscopy?</skos:editorialNote>
    </owl:Class>
    


    <!-- http://edamontology.org/topic__R7WRbf9Y8ySw9QWPwAjzcUa -->

    <owl:Class rdf:about="http://edamontology.org/topic__R7WRbf9Y8ySw9QWPwAjzcUa">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic__RL4rPCXlIu9uzNrGcbcSNp"/>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Imaging of tissues fixed or kept in physiological but artificial conditions.</oboInOwl:hasDefinition>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:label>In-vitro imaging</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/In_vitro"/>
    </owl:Class>
    


    <!-- http://edamontology.org/topic__R89wYXZ2735GXdn4m4GOT9n -->

    <owl:Class rdf:about="http://edamontology.org/topic__R89wYXZ2735GXdn4m4GOT9n">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic__R9P5gEAm1wic4R2PcZ7ZpPA"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic__RBsSZve5PnQFO3scMDWo9f0"/>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Contrast enhancing technique that relies on the exclusion from the image of light not diffracted by the sample.</oboInOwl:hasDefinition>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dark-field microscopy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C85837"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Dark-field_microscopy"/>
    </owl:Class>
    


    <!-- http://edamontology.org/topic__R8Ss4wIFt90wZ1yjFLfXyPM -->

    <owl:Class rdf:about="http://edamontology.org/topic__R8Ss4wIFt90wZ1yjFLfXyPM">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_0611"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_3385"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic____Multimodal_imaging"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://edamontology.org/can_use"/>
                <owl:someValuesFrom rdf:resource="http://edamontology.org/topic_____Array_tomography"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <abbreviation>CLEM</abbreviation>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Correlative light and electron microscopy is the combination of light microscopy (typically fluorescence microscopy) and electron microscopy of the same sample.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Correlative light-electron microscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Integrated light and electron microscopy (ILEM)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Integrated light-electron microscopy</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Volume correlative light and electron microscopy (Volume CLEM)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Correlative light and electron microscopy</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Correlative_light-electron_microscopy"/>
        <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q28457249"/>
    </owl:Class>
    


    <!-- http://edamontology.org/topic__R8XUtD89JCyeUaaVebe9Mkw -->

    <owl:Class rdf:about="http://edamontology.org/topic__R8XUtD89JCyeUaaVebe9Mkw">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic__RL4rPCXlIu9uzNrGcbcSNp"/>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">imaging in the living body of a plant or an animal</oboInOwl:hasDefinition>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:label>In-vivo imaging</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/In_vivo"/>
    </owl:Class>
    


    <!-- http://edamontology.org/topic__R8nlu8VCuL5nvBFgOaGNHgT -->

    <owl:Class rdf:about="http://edamontology.org/topic__R8nlu8VCuL5nvBFgOaGNHgT">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic__R9P5gEAm1wic4R2PcZ7ZpPA"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic__RBsSZve5PnQFO3scMDWo9f0"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topics________010"/>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Microscopy technique taking advantage of the properties of birefringent samples illuminated polarized light and observed through a second polariser perpendicular to the first.</oboInOwl:hasDefinition>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Polarised light microscopy</rdfs:label>
        <rdfs:label xml:lang="en-us">Polarized light microscopy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.bioontology.org/ontology/MESH/D008859"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Polarized_light_microscopy"/>
    </owl:Class>
    


    <!-- http://edamontology.org/topic__R8oQpUEjKZjNQCTB4x3JQuJ -->

    <owl:Class rdf:about="http://edamontology.org/topic__R8oQpUEjKZjNQCTB4x3JQuJ">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_Super-resolution_microscopy"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_Widefield_microscopy"/>
        <abbreviation>SMLM</abbreviation>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SMLM is based on a temporal separation of the emission of fluorescent molecules, allowing a fitting and precise localisation of these molecules.</oboInOwl:hasDefinition>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Direct stochastic optical reconstruction microscopy (dSTORM)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fluorescence photoactivation localisation microscopy (fPALM)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ground state depletion individual molecule return (GSDIM)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Photoactivated localisation microscopy (PALM)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stochastic optical reconstruction microscopy (STORM)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single molecule localisation microscopy</rdfs:label>
        <rdfs:label xml:lang="en-us">Single molecule localization microscopy</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Super-resolution_microscopy#Localization_microscopy"/>
    </owl:Class>
    


    <!-- http://edamontology.org/topic__R96toeNl9iMp8oqv9augU84 -->

    <owl:Class rdf:about="http://edamontology.org/topic__R96toeNl9iMp8oqv9augU84">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_0003"/>
        <oboInOwl:hasBroadSynonym>3D reconstruction</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>Morphological reconstruction</oboInOwl:hasBroadSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:label>In-silico reconstruction</rdfs:label>
    </owl:Class>
    


    <!-- http://edamontology.org/topic__R9Cmje2ZUXyDW6aQAvFhwSM -->

    <owl:Class rdf:about="http://edamontology.org/topic__R9Cmje2ZUXyDW6aQAvFhwSM">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_Fluorescent_microscopy"/>
        <related_term rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optical sectioning</related_term>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Confocal microscopy is fluorescence microscopy in which a pinhole rejects light from out-of-focus planes, allowing an increase in contrast and spatial resolution, mostly axially.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>Confocal fluorescence microscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <oboInOwl:savedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LaureP</oboInOwl:savedBy>
        <oboInOwl:savedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Matúš Kalaš</oboInOwl:savedBy>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Confocal microscopy is restricted to objects which are in the same focal plane.</rdfs:comment>
        <rdfs:label>Confocal microscopy</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Confocal_microscopy"/>
        <skos:editorialNote rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C17753"/>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">We merged this with http://edamontology.org/topic__Rn8MnorStmqIkNlAVZWBc0 (Confocal fluoresc. m.) from alpha06. hadNarrowSynonym&gt;Nipkow disk microscopy</skos:editorialNote>
        <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/MESH/D018613"/>
        <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q902045"/>
    </owl:Class>
    


    <!-- http://edamontology.org/topic__R9O3HmIAjoN5IqXXXRukzzr -->

    <owl:Class rdf:about="http://edamontology.org/topic__R9O3HmIAjoN5IqXXXRukzzr">
