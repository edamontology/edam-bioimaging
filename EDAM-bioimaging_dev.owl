    <!-- http://edamontology.org/topic_2828 -->

    <owl:Class rdf:about="http://edamontology.org/topic_2828">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topics________009"/>
        <created_in>beta12orEarlier</created_in>
        <oboInOwl:hasDefinition>The study of matter and their structure by means of the diffraction of X-rays, typically the diffraction pattern caused by the regularly spaced atoms of a crystalline sample.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>XRD, DRX</oboInOwl:hasExactSynonym>
        <rdfs:label>X-ray diffractometry</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/X-ray_diffraction"/>
        <skos:editorialNote>Is X-ray diffractometry the same as X-ray crystallography/Radiocrystallography/Röntgencrystallography and as X-ray scattering &quot;techniques&quot;?? (That&apos;s what WikiData claim, and old EDAM too).</skos:editorialNote>
        <skos:editorialNote>What about other/lower-res(?) methods such as fiber diffraction, powder diffraction and (if the sample is not crystallized) small-angle X-ray scattering (SAXS)??</skos:editorialNote>
        <skos:editorialNote>X-ray scattering techniques?</skos:editorialNote>
        <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q12101244"/>
    </owl:Class>
    


    <!-- http://edamontology.org/topic_3071 -->

    <owl:Class rdf:about="http://edamontology.org/topic_3071">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_0003"/>
        <created_in>beta13</created_in>
        <isdebtag rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isdebtag>
        <related_term>Data life cycle</related_term>
        <related_term>Data lifecycle</related_term>
        <oboInOwl:hasDbXref>VT 1.3.1 Data management</oboInOwl:hasDbXref>
        <oboInOwl:hasDefinition>Data management comprises the practices and principles of taking care of data, other than analysing them. This includes for example taking care of the associated metadata, data formats, storage, preservation/archiving, access, and legal aspects related to using and sharing data.</oboInOwl:hasDefinition>
        <oboInOwl:hasNarrowSynonym>Metadata management</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Research data management (RDM)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <oboInOwl:savedBy>Matúš Kalaš</oboInOwl:savedBy>
        <oboInOwl:savedBy>bianchini</oboInOwl:savedBy>
        <oboInOwl:savedBy>erin.calhoun</oboInOwl:savedBy>
        <rdfs:comment>The purpose of data management is keeping data consistent, easy to access and use, while ensuring a required level of data protection. Good data management improves the visibility, impact, and lifetime of data.</rdfs:comment>
        <rdfs:label>Data management</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Data_management"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Metadata_management"/>
        <skos:editorialNote>Revise more eventual concepts from https://en.wikipedia.org/wiki/Data_management etc.</skos:editorialNote>
        <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/MSH/D000079803"/>
        <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q1149776"/>
        <skos:narrowMatch rdf:resource="https://www.wikidata.org/wiki/Q30089794"/>
        <skos:narrowMatch rdf:resource="https://www.wikidata.org/wiki/Q6822246"/>
    </owl:Class>
    


