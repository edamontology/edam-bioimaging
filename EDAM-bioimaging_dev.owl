    <!-- http://edamontology.org/operation______Image-to-image_translation -->

    <owl:Class rdf:about="http://edamontology.org/operation______Image-to-image_translation">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_Image_processing"/>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Image-to-image translation is a class of image processing techniques where the goal is to learn the mapping between an input image and an output image. It can be applied to a wide range of applications, such as collection style transfer, imaging modality transfer, object transfiguration, season transfer and photo enhancement.</oboInOwl:hasDefinition>
        <oboInOwl:hasNarrowSynonym rdf:resource="https://www.wikidata.org/wiki/Q64711817"/>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Neural style transfer</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Style transfer</oboInOwl:hasNarrowSynonym>
        <rdfs:label>Image-to-image translation</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Neural_style_transfer"/>
    </owl:Class>
    


