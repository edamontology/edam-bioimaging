    </owl:Class>
    


    <!-- http://edamontology.org/operation_Closing -->

    <owl:Class rdf:about="http://edamontology.org/operation_Closing">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_Morphological_operations"/>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Closing is a morphological operation comprising an erosion followed by a dilation, that is typically used to remove small isolated holes from an image.</oboInOwl:hasDefinition>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/operations"/>
        <rdfs:label>Closing</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Closing_(morphology)"/>
    </owl:Class>
    


    <!-- http://edamontology.org/operation_Dilation -->

    <owl:Class rdf:about="http://edamontology.org/operation_Dilation">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_Morphological_operations"/>
        <oboInOwl:hasDefinition rdf:resource="https://en.wikipedia.org/wiki/Dilation_(morphology)"/>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dilation is a morphological operation which expands the shapes contained in the input image based on analysis of how (a centre of) a given structuring element hits, or misses the shape.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dilatation</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/operations"/>
        <rdfs:label>Dilation</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Dilation"/>
    </owl:Class>
    


    <!-- http://edamontology.org/operation_Distance_transform -->

    <owl:Class rdf:about="http://edamontology.org/operation_Distance_transform">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_Morphological_operations"/>
        <oboInOwl:hasDefinition>Distance transform (distance map or distance field) of a (binary) image, w.r.t. an object in the image, transforms the input image into a representation (another image) so that each pixel is assigned its distance to the (closest) object pixel.</oboInOwl:hasDefinition>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/operations"/>
        <rdfs:comment>Signed distance transform assigns, to each pixel, its distance to the object boundary; background pixels are assigned positive distance values, whereas foreground pixels are assigned negative distance values.</rdfs:comment>
        <rdfs:label>Distance transform</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Distance_transform"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Signed_distance_function"/>
    </owl:Class>
    


    <!-- http://edamontology.org/operation_Edge_detection -->

    <owl:Class rdf:about="http://edamontology.org/operation_Edge_detection">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_Image_enhancement"/>
        <related_term rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Matching filter</related_term>
        <related_term rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Steerable filter</related_term>
        <oboInOwl:hasNarrowSynonym>Edge enhancement</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/operations"/>
        <rdfs:label>Feature enhancement</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://edmontology.org/operation____Top-hat_transform"/>
        <skos:editorialNote>Relation with Edge detection...</skos:editorialNote>
    </owl:Class>
    


    <!-- http://edamontology.org/operation_Erosion -->

    <owl:Class rdf:about="http://edamontology.org/operation_Erosion">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_Morphological_operations"/>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Erosion is a morphological operation used to analyse how a (simple) pre-defined probe (called structuring element) fits or misses the shapes in the image.

Grey scale erosion computed in an image point is the minimum of the intensities of the points in its neighborhood, where the neighborhood is defined by the structuring element.</oboInOwl:hasDefinition>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/operations"/>
        <rdfs:label>Erosion</rdfs:label>
