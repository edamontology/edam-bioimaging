    <!-- http://edamontology.org/topic__R9zg34pnGmTyzPidJj9vfJt -->

    <owl:Class rdf:about="http://edamontology.org/topic__R9zg34pnGmTyzPidJj9vfJt">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic__RBZsLMTdyuEDtVe2fge61l0"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topics________025"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://edamontology.org/can_use"/>
                <owl:someValuesFrom rdf:resource="http://edamontology.org/topic______Ablation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <abbreviation>FIB-SEM</abbreviation>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Type of scanning electron microscopes performing cycles of ablation of the surface of the sample with an ion beam followed by imaging with an electron beam, therefore allowing the acquisition of 3-dimensional data.</oboInOwl:hasDefinition>
