    <!-- http://edamontology.org/topic__RBKlmE9DGTZwEwxw0juThGg -->

    <owl:Class rdf:about="http://edamontology.org/topic__RBKlmE9DGTZwEwxw0juThGg">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_Fluorescent_microscopy"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic__R7Vn7GbwtqVvGWNAMGdcNW1"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_____Non-linear_microscopy"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topics________007"/>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fluorescence microscopy technique in which the fluorescent molecule is excited by multiple photons of a wavelength longer than the emission of the fluorescent molecule.</oboInOwl:hasDefinition>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Three-photon excitation microscopy (3PEM)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Two-photon excitation microscopy (TPEM, 2PEM)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multi-photon microscopy is not confocal in the narrow sense, as it is not using rejection of out-of-focus light (by a pinhole).</rdfs:comment>
        <rdfs:label>Multi-photon microscopy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C116504"/>
        <rdfs:seeAlso rdf:resource="http://purl.bioontology.org/ontology/MESH/D036641"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Two-photon_excitation_microscopy"/>
    </owl:Class>
    


    <!-- http://edamontology.org/topic__RBNfUSYBOKUapWrsyPMMTkw -->

    <owl:Class rdf:about="http://edamontology.org/topic__RBNfUSYBOKUapWrsyPMMTkw">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic__RBZsLMTdyuEDtVe2fge61l0"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic______Cryo_electron_microscopy"/>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Scanning electron microscopy performed on aqueous samples  preserved by freezing in liquid nitrogen.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cryo-scanning electron microscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CryoSEM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cryogenic scanning electron microscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Scanning electron cryomicroscopy</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Cryogenic_electron_microscopy"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Scanning_electron_cryomicroscopy"/>
    </owl:Class>
    


    <!-- http://edamontology.org/topic__RBNoPZIOvBhdWGe8mFNpoWQ -->

    <owl:Class rdf:about="http://edamontology.org/topic__RBNoPZIOvBhdWGe8mFNpoWQ">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_3382"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://edamontology.org/can_use"/>
