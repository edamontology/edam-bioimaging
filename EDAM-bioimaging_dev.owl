        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:label>Medical imaging</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Medical_imaging"/>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Political or philosophical question: Is under Bioimaging (understood as bioscientific imaging), or is bioimaging only specifically for biology? (Preclinical im. even a trichotomy, see there.)</skos:editorialNote>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TODO: More concepts under here, Molecular im., and Preclin.im., either as subconcepts (if always have to imply), or and can use/usable for.</skos:editorialNote>
        <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q931309"/>
    </owl:Class>
    


