    <owl:Class rdf:about="http://edamontology.org/operations________002">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_Image_processing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://edamontology.org/has_topic"/>
