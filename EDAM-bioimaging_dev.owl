        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IFC</oboInOwl:hasExactSynonym>
        <rdfs:label>Imaging flow cytometry</rdfs:label>
    </owl:Class>
    


