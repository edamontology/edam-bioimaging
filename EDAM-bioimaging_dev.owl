        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wikidata.org/wiki/Q898987 is defined as separation or separation method, so rather exactMatch, but it&apos;s titled separation process in English. Therefore relatedMatch.</skos:editorialNote>
        <skos:relatedMatch rdf:resource="https://www.wikidata.org/wiki/Q4751159"/>
        <skos:relatedMatch rdf:resource="https://www.wikidata.org/wiki/Q898987"/>
    </owl:Class>
    


