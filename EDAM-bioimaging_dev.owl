        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Generative_artificial_intelligence"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Generative_model"/>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Before was Generative artificial intelligence (Generative AI, GenAI, GAI) as a narrow to Gen.stat.mod.</skos:editorialNote>
