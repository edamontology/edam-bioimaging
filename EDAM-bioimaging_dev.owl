    <!-- http://edamontology.org/topic_______Boltzmann_machine -->

    <owl:Class rdf:about="http://edamontology.org/topic_______Boltzmann_machine">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic______Recurrent_neural_network"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_______Generative_machine_learning"/>
        <oboInOwl:hasBroadSynonym rdf:resource="https://www.wikidata.org/wiki/Q1407668"/>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hopfield network?</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Statistical Hopfield network?</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym rdf:resource="https://www.wikidata.org/wiki/Q194706"/>
        <oboInOwl:hasNarrowSynonym rdf:resource="https://www.wikidata.org/wiki/Q7316287"/>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deep Boltzmann machine (DBM)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Restricted Boltzmann machine (RBM)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spike-and-slab RBM</oboInOwl:hasNarrowSynonym>
        <rdfs:label>Boltzmann machine</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Boltzmann_machine"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Hopfield_network"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Restricted_Boltzmann_machine"/>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Questions to think about:
- Is this a special case of Hopfield network?
- Is Hopfield network worth adding too, i.e. is it relevant in science applications these days?
- Where does this/do these fit within Statistics/Statistical models/Probabilistic models?
- Is DBM a (Probabilistic) graphical model?
- AND THE QUESTION OF THE DAY: Are there Generative ML models which are NOT Statistical models??</skos:editorialNote>
    </owl:Class>
    


