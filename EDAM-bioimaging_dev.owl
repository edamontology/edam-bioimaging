        <rdfs:label>Data sorting</rdfs:label>
    </owl:Class>
    


    <!-- http://edamontology.org/operation_3803 -->

    <owl:Class rdf:about="http://edamontology.org/operation_3803">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_3214"/>
        <created_in>1.17</created_in>
        <oboInOwl:hasDefinition>Mass spectra identification of compounds that are produced by living systems. Including polyketides, terpenoids, phenylpropanoids, alkaloids and antibiotics.</oboInOwl:hasDefinition>
        <oboInOwl:hasNarrowSynonym>De novo metabolite identification</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Fragmenation tree generation</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Metabolite identification</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/operations"/>
        <rdfs:label>Natural product identification</rdfs:label>
    </owl:Class>
    


    <!-- http://edamontology.org/operation_3935 -->

    <owl:Class rdf:about="http://edamontology.org/operation_3935">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_3438"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://edamontology.org/has_input"/>
                <owl:someValuesFrom rdf:resource="http://edamontology.org/data_0943"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <created_in>1.24</created_in>
        <oboInOwl:hasDefinition>A process used in statistics, machine learning, and information theory that reduces the number of random variables by obtaining a set of principal variables.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>Dimension reduction</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/operations"/>
        <rdfs:label>Dimensionality reduction</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Dimensionality_reduction"/>
    </owl:Class>
    


    <!-- http://edamontology.org/operation_3936 -->

    <owl:Class rdf:about="http://edamontology.org/operation_3936">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_3935"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://edamontology.org/has_input"/>
                <owl:someValuesFrom rdf:resource="http://edamontology.org/data_0943"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <created_in>1.24</created_in>
        <oboInOwl:hasDefinition>A dimensionality reduction process that selects a subset of relevant features (variables, predictors) for use in model construction.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>Attribute selection</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Variable selection</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Variable subset selection</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/operations"/>
        <rdfs:label>Feature selection</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Feature_selection"/>
    </owl:Class>
    


    <!-- http://edamontology.org/operation_3937 -->

    <owl:Class rdf:about="http://edamontology.org/operation_3937">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_3935"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://edamontology.org/has_input"/>
                <owl:someValuesFrom rdf:resource="http://edamontology.org/data_0943"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <created_in>1.24</created_in>
        <oboInOwl:hasDefinition>A dimensionality reduction process which builds (ideally) informative and non-redundant values (features) from an initial set of measured data, to aid subsequent generalization, learning or interpretation.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>Feature projection</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/operations"/>
        <rdfs:label>Feature extraction</rdfs:label>
    </owl:Class>
    


    <!-- http://edamontology.org/operation_3960 -->

    <owl:Class rdf:about="http://edamontology.org/operation_3960">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_2238"/>
        <created_in>1.25</created_in>
        <oboInOwl:hasDefinition>A statistical procedure that uses an orthogonal transformation to convert a set of observations of possibly correlated variables into a set of values of linearly uncorrelated variables called principal components.</oboInOwl:hasDefinition>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/operations"/>
        <rdfs:label>Principal component analysis</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Principal_component_analysis"/>
    </owl:Class>
    


    <!-- http://edamontology.org/operation_4031 -->

    <owl:Class rdf:about="http://edamontology.org/operation_4031">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_2238"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://edamontology.org/has_topic"/>
                <owl:someValuesFrom rdf:resource="http://edamontology.org/topic_3572"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <created_in>1.26</created_in>
        <oboInOwl:hasDefinition>The estimation of the power of a test; that is the probability of correctly rejecting the null hypothesis when it is false.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>Estimation of statistical power</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Power analysis</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/operations"/>
        <rdfs:label>Power test</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Power_of_a_test"/>
    </owl:Class>
    


    <!-- http://edamontology.org/operation_4034 -->

    <owl:Class rdf:about="http://edamontology.org/operation_4034">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_2238"/>
        <created_in>1.26</created_in>
        <oboInOwl:hasDefinition>The correction of p-values from multiple statistical tests to correct for false positives.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>FDR estimation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>False discovery rate estimation</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/operations"/>
        <rdfs:label>Multiple testing correction</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Multiple_comparisons_problem"/>
    </owl:Class>
    


    <!-- http://edamontology.org/operation_4042 -->

    <owl:Class rdf:about="http://edamontology.org/operation_4042">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_0004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://edamontology.org/has_output"/>
                <owl:someValuesFrom rdf:resource="http://edamontology.org/data_4040"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://edamontology.org/has_topic"/>
                <owl:someValuesFrom rdf:resource="http://edamontology.org/topic_3071"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <created_in>1.26</created_in>
        <oboInOwl:created_by>bianchini</oboInOwl:created_by>
        <oboInOwl:creation_date>2023-03-02</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Data management planning is the process of creating and updating a data management plan (DMP) for a project or an organisation.</oboInOwl:hasDefinition>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/operations"/>
        <oboInOwl:savedBy>Matúš Kalaš</oboInOwl:savedBy>
        <oboInOwl:savedBy>bianchini</oboInOwl:savedBy>
        <rdfs:comment>Good data management planning prevents unexpected legal issues or extra costs related to usage, sharing, storage, or archival of data.</rdfs:comment>
        <rdfs:comment>Policies often require the submission of a data management plan (DMP) together with a project proposal. A detailed, revised version of the DMP may be required as part of the project&apos;s final report.</rdfs:comment>
        <rdfs:label>Data management planning</rdfs:label>
    </owl:Class>
    


    <!-- http://edamontology.org/operation_4043 -->

    <owl:Class rdf:about="http://edamontology.org/operation_4043">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_2409"/>
        <created_in>1.26</created_in>
        <related_term>Digital preservation</related_term>
        <oboInOwl:created_by>bianchini</oboInOwl:created_by>
        <oboInOwl:creation_date>2023-03-02T12:02:42.14696Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Data digitisation is the process of converting analog data, text, or information into a digital format, appropriate for computational analysis and preservation.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en-us">Data digitalisation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en-us">Data digitalization</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>Digital reformatting</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/operations"/>
        <oboInOwl:savedBy>Matúš Kalaš</oboInOwl:savedBy>
        <oboInOwl:savedBy>bianchini</oboInOwl:savedBy>
        <rdfs:label>Data digitisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://en.wikipedia.org/wiki/Digitization"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Digital_preservation"/>
        <skos:editorialNote xml:lang="en-us">Data digitization</skos:editorialNote>
        <skos:editorialNote>Metadata recording?</skos:editorialNote>
        <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q843958"/>
        <skos:relatedMatch rdf:resource="https://www.wikidata.org/wiki/Q632897"/>
    </owl:Class>
    


    <!-- http://edamontology.org/operation_Active_contours -->

    <owl:Class rdf:about="http://edamontology.org/operation_Active_contours">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation____Model-based_segmentation"/>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&apos;Active contours&apos; is an energy-minimizing deformable parametric contour, that is typically used to segment image regions enclosed by edges.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>Active contour model</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Active contour models</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>Snakes</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/operations"/>
        <rdfs:label>Active contours</rdfs:label>
    </owl:Class>
    


