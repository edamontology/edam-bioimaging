    <!-- http://edamontology.org/topic______Airyscan -->

    <owl:Class rdf:about="http://edamontology.org/topic______Airyscan">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topics________007"/>
        <related_term rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Airyscan</related_term>
        <related_term rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Matrix detector</related_term>
        <related_term rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multi-point detector</related_term>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multi-point detection microscopy</rdfs:label>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Airyscan is a name from a vendor. Another vendors call it differently, e.g. Matrix detector. The image reconstruction afterwards might be different.</skos:editorialNote>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Airyscan is in any case point-scanning, with a very small array detector (LaureP), and not confocal in the narrow sense (even if it is part of the same machine).</skos:editorialNote>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enhanced resolution</skos:editorialNote>
    </owl:Class>
    


