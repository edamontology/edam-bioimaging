    <owl:Class rdf:about="http://edamontology.org/topic_2229">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_4019"/>
        <created_in>beta12orEarlier</created_in>
        <oboInOwl:hasExactSynonym>Cell biology</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Cellular biology</oboInOwl:hasExactSynonym>
