    <!-- http://edamontology.org/topic______Optical_Coherence_Tomography -->

    <owl:Class rdf:about="http://edamontology.org/topic______Optical_Coherence_Tomography">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_3452"/>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OCT is a label free detection technique, that uses low-coherence light to capture micrometer-resolution, two- and three-dimensional images from within scattering tissues.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OCT</oboInOwl:hasExactSynonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optical coherence tomography</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Optical_coherence_tomography"/>
    </owl:Class>
    


    <!-- http://edamontology.org/topic______Optical_Projection_Tomography -->

    <owl:Class rdf:about="http://edamontology.org/topic______Optical_Projection_Tomography">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_3452"/>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OPT is a form of tomography using visible light to generate 3D image volumes based on absorption (label-free) or fluorescence.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OPT</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optical tomography</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optical computed tomography</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optical emission computed tomography</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optical tomography</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">optical-CT</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">optical-ECT</oboInOwl:hasNarrowSynonym>
        <rdfs:label>Optical projection tomography</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Optical_projection_tomography"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Optical_tomography"/>
    </owl:Class>
    


