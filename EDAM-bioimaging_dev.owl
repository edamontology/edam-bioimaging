    <!-- http://edamontology.org/topic___Fluorescence_correlative_spectroscopy -->

    <owl:Class rdf:about="http://edamontology.org/topic___Fluorescence_correlative_spectroscopy">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_Fluorescent_microscopy"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic__RBfI2XgIsxcfKonPPluKAhK"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topics________007"/>
        <abbreviation>FCS</abbreviation>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FCS measures fluctuations of fluorescence in a volume, providing after analysis physical parameters of the sample such as diffusion coefficient or concentration.</oboInOwl:hasDefinition>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fluorescence Lifetime Correlation Microscopy (FLCS)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fluorescence cross-correlation spectroscopy (FCCS)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fluorescence correlation spectroscopy</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Fluorescence_correlation_spectroscopy"/>
    </owl:Class>
    


    <!-- http://edamontology.org/topic___Fluorescence_lifetime_imaging -->

    <owl:Class rdf:about="http://edamontology.org/topic___Fluorescence_lifetime_imaging">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_Fluorescent_microscopy"/>
        <abbreviation>FLIM</abbreviation>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fluorescence microscopy technique based on recording the lifetime of emission of a sample rather than the intensity of emission.</oboInOwl:hasDefinition>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Can be done with widefield or confocal.</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Can be with array or point detectors.</rdfs:comment>
        <rdfs:label>Fluorescence lifetime imaging microscopy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://bioportal.bioontology.org/ontologies/NCIT/?p=classes&amp;conceptid=http%3A%2F%2Fncicb.nci.nih.gov%2Fxml%2Fowl%2FEVS%2FThesaurus.owl%23C154786&amp;jump_to_nav=true"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Fluorescence-lifetime_imaging_microscopy"/>
        <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q1434196"/>
    </owl:Class>
    


    <!-- http://edamontology.org/topic___Fluorescence_recovery_after_photobleaching -->

    <owl:Class rdf:about="http://edamontology.org/topic___Fluorescence_recovery_after_photobleaching">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_Fluorescent_microscopy"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic__RL4rPCXlIu9uzNrGcbcSNp"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic______Photomanipulation"/>
        <abbreviation>FRAP</abbreviation>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Microscopy method for studying kinetics of diffusion of molecules in a sample.</oboInOwl:hasDefinition>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fluorescence localization after photobleaching (FLAP)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fluorescence loss in photobleaching (FLIP)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Inverse fluorescence recovery after photobleaching (iFRAP)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Can be widefield or confocal.</rdfs:comment>
        <rdfs:label>Fluorescence recovery after photobleaching</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Fluorescence_recovery_after_photobleaching"/>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Can be with array or point detectors.</skos:editorialNote>
    </owl:Class>
    


    <!-- http://edamontology.org/topic___Foerster_resonance_energy_transfer -->

    <owl:Class rdf:about="http://edamontology.org/topic___Foerster_resonance_energy_transfer">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_Fluorescent_microscopy"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic______Photomanipulation"/>
        <abbreviation>FRET</abbreviation>
        <oboInOwl:hasDefinition>FRET allows to study the distance between light sensitive molecules by monitoring the transfer of energy between them.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electronic energy transfer (EET)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Fluorescence resonance energy transfer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single-molecule FRET (smFRET)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Can be widefield or confocal fluorescence microscopy.</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Can be with array or point detectors.</rdfs:comment>
        <rdfs:label>Förster resonance energy transfer</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Förster_resonance_energy_transfer"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Single-molecule_FRET"/>
    </owl:Class>
    


