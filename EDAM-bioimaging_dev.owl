    </owl:Class>
    


    <!-- http://edamontology.org/data_______Ion_image -->

    <owl:Class rdf:about="http://edamontology.org/data_______Ion_image">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/data_Image"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/data_______Data_cube"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://edamontology.org/has_topic"/>
                <owl:someValuesFrom rdf:resource="http://edamontology.org/topic_____Mass_spectrometry_imaging"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://edamontology.org/part_of"/>
                <owl:someValuesFrom rdf:resource="http://edamontology.org/data_______Mass_spectroscopy_imaging_data_set"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ion image is an array of intensity values (abundance of the given ionised molecule type) for each pixel/voxel in an image.</oboInOwl:hasDefinition>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An ion image is understood as intensities for one ion (one type of ionised molecule). In practice, hundreds to thousands of molecules are part of a mass spectroscopy imaging data set.</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The underlying image is usually 2D (plus the intensities).</rdfs:comment>
        <rdfs:label>Ion image</rdfs:label>
    </owl:Class>
    


    <!-- http://edamontology.org/data_______Ion_image_annotation -->

    <owl:Class rdf:about="http://edamontology.org/data_______Ion_image_annotation">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_3553"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://edamontology.org/has_input"/>
                <owl:someValuesFrom rdf:resource="http://edamontology.org/data_Roi"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://edamontology.org/has_input"/>
                <owl:someValuesFrom rdf:resource="http://edamontology.org/data_______Ion_image"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://edamontology.org/has_output"/>
                <owl:someValuesFrom rdf:resource="http://edamontology.org/data_______Ion_image"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ion image labelling?</oboInOwl:hasExactSynonym>
        <rdfs:label>Ion image annotation</rdfs:label>
    </owl:Class>
    


    <!-- http://edamontology.org/data_______Mass_spectroscopy_imaging_data_set -->

    <owl:Class rdf:about="http://edamontology.org/data_______Mass_spectroscopy_imaging_data_set">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/data_0006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://edamontology.org/has_part"/>
                <owl:someValuesFrom rdf:resource="http://edamontology.org/data_0943"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://edamontology.org/has_part"/>
                <owl:someValuesFrom rdf:resource="http://edamontology.org/data_______Ion_image"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://edamontology.org/has_topic"/>
                <owl:someValuesFrom rdf:resource="http://edamontology.org/topic_____Mass_spectrometry_imaging"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mass spectrometry imaging data</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mass spectrometry imaging data set is a data cube (typically 4D), consisting of a list of ion images (intensities in all/some(?) positions for 1 molecule type), and a list of mass spectra (intensities of all molecule types for 1 position). So ion image(s) and mass spectra are both part(s) of an MSI data set.</skos:definition>
    </owl:Class>
    


    <!-- http://edamontology.org/data________001 -->

    <owl:Class rdf:about="http://edamontology.org/data________001">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/data_0006"/>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Matúš Kalaš, Teresa Zulueta-Coarasa</oboInOwl:created_by>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-05-26T13:16:22.190432Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spatial annotation data</oboInOwl:hasBroadSynonym>
        <rdfs:label>Image annotation data</rdfs:label>
    </owl:Class>
    


    <!-- http://edamontology.org/data________002 -->

    <owl:Class rdf:about="http://edamontology.org/data________002">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/data_Roi"/>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Teresa Zulueta-Coarasa</oboInOwl:created_by>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-05-26T13:33:45.072746Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">image annotation data consisting of rectangles or rectangular prisms completely enclosing a structure of interest within an image</oboInOwl:hasDefinition>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bounding box</rdfs:label>
    </owl:Class>
    


    <!-- http://edamontology.org/data________003 -->

    <owl:Class rdf:about="http://edamontology.org/data________003">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/data________001"/>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Teresa Zulueta-Coarasa</oboInOwl:created_by>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-05-26T13:41:08.386161Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">image annotation data that identify specific features, patterns or classes in images. They can be given for a whole image or for individual structures within it</oboInOwl:hasDefinition>
        <rdfs:label>Class labels</rdfs:label>
    </owl:Class>
    


    <!-- http://edamontology.org/data________005 -->

    <owl:Class rdf:about="http://edamontology.org/data________005">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/data__Rj7rpnkJ6SPPwWkQ4x3Wik"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/data________001"/>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Teresa Zulueta-Coarasa</oboInOwl:created_by>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-05-26T13:41:57.315583Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">image annotation data that count the number of objects (such as cells) in the the image</oboInOwl:hasDefinition>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Object counts</rdfs:label>
    </owl:Class>
    


    <!-- http://edamontology.org/data________006 -->

    <owl:Class rdf:about="http://edamontology.org/data________006">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/data________001"/>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Teresa Zulueta-Coarasa</oboInOwl:created_by>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-05-26T13:43:28.736303Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">additional analytical annotation data extracted from the images. For example, the image point spread function, the signal-to-noise ratio and focus information</oboInOwl:hasDefinition>
        <rdfs:label>Derived annotations</rdfs:label>
    </owl:Class>
    


    <!-- http://edamontology.org/data________007 -->

    <owl:Class rdf:about="http://edamontology.org/data________007">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/data_Roi"/>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Teresa Zulueta-Coarasa</oboInOwl:created_by>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-05-26T13:44:55.310193Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Image annotation data consisting of polygons and shapes that follow the outline of a region of interest in the image. These can be geometrical primitives, 2D polygons and 3D meshes.</oboInOwl:hasDefinition>
        <rdfs:label>Geometrical annotations</rdfs:label>
    </owl:Class>
    


    <!-- http://edamontology.org/data________008 -->

    <owl:Class rdf:about="http://edamontology.org/data________008">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/data_Roi"/>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Matúš Kalaš, Teresa Zulueta-Coarasa</oboInOwl:created_by>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-05-26T13:45:24.927701Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">image annotation data consisting of an image, the same size as the source image, with the value of each pixel representing some biological identity or background region</oboInOwl:hasDefinition>
        <rdfs:label>Segmentation mask</rdfs:label>
    </owl:Class>
    


    <!-- http://edamontology.org/data________009 -->

    <owl:Class rdf:about="http://edamontology.org/data________009">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/data________001"/>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Teresa Zulueta-Coarasa</oboInOwl:created_by>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-05-26T13:45:38.746241Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">graph-based image annotation data describing the morphology, connectivity, or spatial organisation of biological structures within an image. Graphs, such as skeletons or connectivity diagrams, typically consist of nodes and edges, where nodes represent individual elements or regions and edges represent the connections or interactions between them</oboInOwl:hasDefinition>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Image annotation graph</rdfs:label>
    </owl:Class>
    


    <!-- http://edamontology.org/data________010 -->

    <owl:Class rdf:about="http://edamontology.org/data________010">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/data________001"/>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Teresa Zulueta-Coarasa</oboInOwl:created_by>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-05-26T13:46:23.533868Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">image annotation data noting X, Y and Z coordinates of a point of interest in an image (for example, an object’s centroid or biological landmarks such as particle positions in cryoEM, cryoET or spatial transcriptomics)</oboInOwl:hasDefinition>
        <rdfs:label>Point annotations</rdfs:label>
    </owl:Class>
    


    <!-- http://edamontology.org/format_1915 -->

    <owl:Class rdf:about="http://edamontology.org/format_1915">
        <owl:disjointWith rdf:resource="http://edamontology.org/operation_0004"/>
        <owl:disjointWith rdf:resource="http://edamontology.org/topic_0003"/>
        <created_in>beta12orEarlier</created_in>
        <notRecommendedForAnnotation rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</notRecommendedForAnnotation>
        <oboInOwl:hasDefinition>A defined way or layout of representing and structuring data in a computer file, blob, string, message, or elsewhere.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>Data format</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Data model</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Exchange format</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>File format</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/formats"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <rdfs:label>Format</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://en.wikipedia.org/wiki/File_format"/>
        <rdfs:seeAlso rdf:resource="http://en.wikipedia.org/wiki/List_of_file_formats"/>
        <skos:broadMatch rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <skos:broadMatch rdf:resource="http://purl.org/biotop/biotop.owl#Quality"/>
        <skos:broadMatch rdf:resource="http://purl.org/dc/elements/1.1/format"/>
        <skos:broadMatch rdf:resource="http://semanticscience.org/resource/SIO_000612"/>
        <skos:broadMatch rdf:resource="http://www.onto-med.de/ontologies/gfo.owl#Perpetuant"/>
        <skos:broadMatch rdf:resource="http://www.onto-med.de/ontologies/gfo.owl#Symbol_structure"/>
        <skos:editorialNote>Work comment:
Xavier Heiligenstein
