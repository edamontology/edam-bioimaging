            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Imaging of biological tissues preserved by chemicals or temperature.</oboInOwl:hasDefinition>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
