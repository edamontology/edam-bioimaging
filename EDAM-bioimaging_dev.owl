    <!-- http://edamontology.org/topics________044 -->

    <owl:Class rdf:about="http://edamontology.org/topics________044">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_3385"/>
        <abbreviation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cryo-LM</abbreviation>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Matúš Kalaš</oboInOwl:created_by>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-05-03T22:04:20.183075Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cryogenic light microscopy is a light microscopy technique for studying samples at very low (cryogenic) temperature.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cryo light microscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Light cryomicroscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cryoLM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cryo fluorescence microscopy</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cryogenic fluorescence microscopy (cryo-FM, cryoFM)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fluorescence cryomicroscopy</oboInOwl:hasNarrowSynonym>
        <rdfs:label>Cryogenic light microscopy</rdfs:label>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cryo-LM vs. cryo-FM: Do people use cryoLM term for cryoFM? If yes, then we should model only cryo-FM. See similar concern at LSFM.</skos:editorialNote>
    </owl:Class>
    


