    <!-- http://edamontology.org/operation___Clustering -->

    <owl:Class rdf:about="http://edamontology.org/operation___Clustering">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_0004"/>
        <_permanent_id rdf:resource="http://edamontology.org/operation_3432"/>
        <created_in rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.6</created_in>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clustering (or cluster analysis) is a process of grouping a set of data points (objects) in such a way that objects in the same group (forming a cluster) are, in some sense,  more similar to each other than to those in other groups (clusters).

Clustering is sometimes referred to as unsupervised classification.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cluster analysis</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/operations"/>
        <rdfs:label>Clustering</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Cluster_analysis"/>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Legacy definition from EDAM: Group together some data entities on the basis of similarities such that entities in the same group (cluster) are more similar to each other than to those in other groups (clusters).</skos:editorialNote>
    </owl:Class>
    


