    <!-- http://edamontology.org/operation_Skeletonization -->

    <owl:Class rdf:about="http://edamontology.org/operation_Skeletonization">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_Morphological_operations"/>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Skeletonisation is a process for generating fogroundreducing foreground regions in a binary image to a skeletal remnant that largely preserves the extent and connectivity of the original region while throwing away most of the original foreground pixels</oboInOwl:hasDefinition>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Skeletonisation is a process of reducing a foreground region in a (binary) image into its simplified, topologically equivalent representation - skeleton. The new representation contains highly reduced number of foreground pixels, while largely preserving the extent and connectivity of the original region.</oboInOwl:hasDefinition>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Medial axis transform</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/operations"/>
        <rdfs:label>Skeletonisation</rdfs:label>
    </owl:Class>
    


