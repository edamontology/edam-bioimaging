    <!-- http://edamontology.org/topic_Light-sheet_microscopy -->

    <owl:Class rdf:about="http://edamontology.org/topic_Light-sheet_microscopy">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_Fluorescent_microscopy"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic__RBsSZve5PnQFO3scMDWo9f0"/>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Light sheet fluorescence microscopy is a fluorescence microscopy technique where the illumination of the sample is performed along a plane and where the detection arm collects the emitted fluorescence from this plane.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LSFM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Light-sheet fluorescence microscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Airy beam light-sheet microscopy</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Axially swept light sheet microscopy</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bessel beam multiphoton lightsheet microscopy</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Digitally scanned laser light-sheet microscopy (DSLM)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Epi-illumination SPIM (eSPIM)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lattice light-sheet microscopy (LLS)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mesoscale selective plane illumination microscopy (mesoSPIM)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Objective-coupled planar illumination (OCPI) microscopy</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Oblique plane microscopy (OPM)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Open-access lightsheet microscopy platform</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Open-top light-sheet microscopy (OTLS)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Orthogonal-plane fluorescence optical sectioning (OPFOS)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Selective plane illumination microscopy (SPIM)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single plane illumination microscopy</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Structured illumination light sheet microscopy (SI-LSM)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Swept confocally-aligned planar excitation microscopy (SCAPE)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thin sheet laser imaging microscopy (TSLIM)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bessel beam lightsheet microscopy</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CLARITY optimised light sheet microscopy (COLM)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clarity-optimised light-sheet microscopy</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dual-view inverted SPIM (diSPIM)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inverted SPIM (iSPIM)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lattice light-sheet microscopy (LLSM)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multidirectional SPIM (mSPIM)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multiview selective plane illumination microscopy (MuViSPIM)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optical projection tomography in light sheet microscopy (OPTiSPIM)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single-objective selective plane illumination microscopy (soSPIM)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spherical aberrations-assisted extended depth-of-field light-sheet microscopy (SPED)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <oboInOwl:savedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Adriaan Ludl, Julien Colombelli, Matúš Kalaš</oboInOwl:savedBy>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Light sheet microscopy (LSM) in general: Some non-fluorescence techniques exist, that also use light sheet illumination.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Light sheet fluorescence microscopy</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Light_sheet_fluorescence_microscopy"/>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inventory: https://docs.google.com/spreadsheets/d/17njcIcvS_g0oh9yVEyMgrEJKFUYolNjVNxfwL2uM7kw/edit?usp=sharing</skos:editorialNote>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Light sheet microscopy (LSM) in general: Rather not model a separate super-concept, as users would use it instead of LSFM.</skos:editorialNote>
    </owl:Class>
    


    <!-- http://edamontology.org/topic_Microscopy -->

    <owl:Class rdf:about="http://edamontology.org/topic_Microscopy">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_3382"/>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The use of microscopes to enlarge objects that are too small to be seen with the naked eye.</oboInOwl:hasDefinition>
        <oboInOwl:hasNarrowSynonym>Slide scanner</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:label>Microscopy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://bioportal.bioontology.org/ontologies/NCIT/?p=classes&amp;conceptid=http%3A%2F%2Fncicb.nci.nih.gov%2Fxml%2Fowl%2FEVS%2FThesaurus.owl%23C16853&amp;jump_to_nav=true"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Microscopy"/>
    </owl:Class>
    


