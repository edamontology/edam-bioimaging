        <oboInOwl:hasDefinition>Counting and measuring experimentally determined observations into quantities.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>Quantitation</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/operations"/>
        <rdfs:label>Quantification</rdfs:label>
    </owl:Class>
    


    <!-- http://edamontology.org/operation_3800 -->

    <owl:Class rdf:about="http://edamontology.org/operation_3800">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_3799"/>
        <created_in>1.17</created_in>
