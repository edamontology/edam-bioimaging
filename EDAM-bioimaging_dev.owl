    <!-- http://edamontology.org/topic____Multimodal_imaging -->

    <owl:Class rdf:about="http://edamontology.org/topic____Multimodal_imaging">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_3382"/>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multi-modal imaging</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Multisensor imaging</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>Correlative imaging</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Correlative microscopy</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Hybrid imaging</oboInOwl:hasNarrowSynonym>
        <rdfs:comment>Utilizing different imaging modalities in combination</rdfs:comment>
        <rdfs:label>Multimodal imaging</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C19341"/>
        <rdfs:seeAlso rdf:resource="http://purl.bioontology.org/ontology/MESH/D064847"/>
    </owl:Class>
    


    <!-- http://edamontology.org/topic_____Array_tomography -->

    <owl:Class rdf:about="http://edamontology.org/topic_____Array_tomography">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_3452"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://edamontology.org/can_use"/>
                <owl:someValuesFrom rdf:resource="http://edamontology.org/topic______Microtomy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Can be just EM or anything. But may also combine optical and electron microscopy of ultra thin serial sections.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Serial sectioning microscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:savedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-10-26 Anna Seybold, Matúš Kalaš</oboInOwl:savedBy>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">volumetric microscopy method based on physical serial sectioning. Can be appyied in LM and EM. Work comment: should we even remove it from underneath Tomography and instead put it somewhere to Image Prep?</rdfs:comment>
        <rdfs:label>Array tomography</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://doi.org/10.1016/j.neuron.2007.06.014"/>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pity there is no Wikipedia article (yet).</skos:editorialNote>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Always uses microtomy, specifically serial sectioning. Serial sectioning means the sectioning is done serially, i.e. for the whole/big part of the sample.</skos:editorialNote>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is non-destructive as opposed to volume SEM techniques. So the sections can be imaged again. As opposed to generic tomography, there are the physical sections.</skos:editorialNote>
    </owl:Class>
    


