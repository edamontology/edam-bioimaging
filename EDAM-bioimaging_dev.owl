    </owl:Class>
    


    <!-- http://edamontology.org/topic__RByvmgDpAo4FOrMdvTm1gwR -->

    <owl:Class rdf:about="http://edamontology.org/topic__RByvmgDpAo4FOrMdvTm1gwR">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic__RBZsLMTdyuEDtVe2fge61l0"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topics________025"/>
        <abbreviation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SBF-SEM</abbreviation>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An ultramicrotome present inside the SEM allow for serial sectioning of the sample between acquisitions therefore allowing for the generation of 3-dimensional data.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SBEM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SBF SEM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SBFSEM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3View®</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cryogenic serial block-face scanning electron microscopy (cryo-SBF-SEM)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Serial block-face scanning electron cryomicroscopy</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[3View®] It is not in scope of EDAM to list and model products and vendors, with exceptions of those that are crucial keywords for end users to search for. Todo: add this into general EDAM guidelines.</rdfs:comment>
        <rdfs:label>Serial block-face scanning electron microscopy</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Serial_block-face_scanning_electron_microscopy"/>
    </owl:Class>
    


    <!-- http://edamontology.org/topic__RC91JqkkQnsmvg8zuG6Td7q -->

    <owl:Class rdf:about="http://edamontology.org/topic__RC91JqkkQnsmvg8zuG6Td7q">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_Super-resolution_microscopy"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic__RBsSZve5PnQFO3scMDWo9f0"/>
        <abbreviation>SIM</abbreviation>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A patterned illumination interferes with the sample and creates moire fringes which are further processed by an algorithm to increase spatial resolution.</oboInOwl:hasDefinition>
        <oboInOwl:hasRelatedSynonym>Instant linear structured Illumination Microscopy</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multifocal structured illumination microscopy (MSIM)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Saturated structured illumination microscopy (SSIM)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>iSIM</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Structured illumination microscopy includes also techniques that do not rely on fluorescence.</rdfs:comment>
        <rdfs:label>Structured illumination microscopy</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Super-resolution_microscopy#Structured_illumination_microscopy_(SIM)"/>
    </owl:Class>
    


