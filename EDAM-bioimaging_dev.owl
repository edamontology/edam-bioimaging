    <!-- http://edamontology.org/topic_____Total_internal_reflection_fluorescence_microscopy -->

    <owl:Class rdf:about="http://edamontology.org/topic_____Total_internal_reflection_fluorescence_microscopy">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_Fluorescent_microscopy"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic__RBsSZve5PnQFO3scMDWo9f0"/>
        <abbreviation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TIRF</abbreviation>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Type of microscopy using a high angle of incidence of a laser to produce an evanescent field to selectively excite fluorophores in close proximity to the coverslip.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>Evanescent wave microscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TIRFM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HiLo microscopy</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Highly inclined and laminated optical sheet (HiLo)</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Total internal reflection fluorescence microscopy</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Total_internal_reflection_fluorescence_microscope"/>
        <skos:editorialNote>Q: Is Evanescent wave microscopy an exact or broad synonym, or Evanescent wave/field a related term? The latter however also in NSOM/SNOM!!</skos:editorialNote>
    </owl:Class>
    


