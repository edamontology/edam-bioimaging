    <!-- http://edamontology.org/topic_4044 -->

    <owl:Class rdf:about="http://edamontology.org/topic_4044">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_3071"/>
        <created_in>1.26</created_in>
        <related_term>Classified information</related_term>
        <related_term>Confidential information</related_term>
        <related_term>Data privacy</related_term>
        <related_term>Information privacy</related_term>
        <related_term>Information sensitivity</related_term>
        <related_term>Personal data</related_term>
        <related_term>Private data</related_term>
        <related_term>Sensitive data</related_term>
        <related_term>Sensitive human data</related_term>
        <related_term>Sensitive information</related_term>
        <related_term>Special category data</related_term>
        <oboInOwl:hasDefinition>Data protection is a topic concerning data that should be protected from disclosure, damage, or unauthorised access, due to its sensitive nature.</oboInOwl:hasDefinition>
        <oboInOwl:hasRelatedSynonym>Management of sensitive data</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <oboInOwl:savedBy>Matúš Kalaš</oboInOwl:savedBy>
        <oboInOwl:savedBy>bianchini</oboInOwl:savedBy>
        <rdfs:comment>Note that the term information security (https://en.wikipedia.org/wiki/Information_security) covers both the data management aspect for protected data (this topic_4044), and the technical aspect of cybersecurity (topic_4045).</rdfs:comment>
        <rdfs:comment>Sensitive data includes not only personal and commercial data, but also information about e.g. localisation of endangered biological species that could be exploited.</rdfs:comment>
        <rdfs:label>Data protection</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/General_Data_Protection_Regulation"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Information_privacy"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Information_sensitivity"/>
        <skos:closeMatch rdf:resource="https://www.wikidata.org/wiki/Q2587068"/>
        <skos:closeMatch rdf:resource="https://www.wikidata.org/wiki/Q456632"/>
        <skos:relatedMatch rdf:resource="https://www.wikidata.org/wiki/Q1172506"/>
    </owl:Class>
    


