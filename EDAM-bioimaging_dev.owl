        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_3383"/>
        <_permanent_id rdf:resource="http://edamontology.org/topic_3384"/>
        <created_in>1.4</created_in>
        <oboInOwl:hasDbXref>VT 3.2.13 Medical imaging</oboInOwl:hasDbXref>
