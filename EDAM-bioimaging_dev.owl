    <!-- http://edamontology.org/topic_______Imaging_mass_cytometry -->

    <owl:Class rdf:about="http://edamontology.org/topic_______Imaging_mass_cytometry">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_____Mass_spectrometry_imaging"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_______Mass_cytometry"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_______Multiplexed_immunohistochemistry"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_______Tissue_cytometry"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#related"/>
                <owl:someValuesFrom rdf:resource="http://edamontology.org/topic_______Laser_ablation_inductively_coupled_plasma_imaging"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#related"/>
                <owl:someValuesFrom rdf:resource="http://edamontology.org/topic_______Secondary_ion_mass_spectrometry_imaging"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IMC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CyTOF imaging</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CyTOF tissue imaging</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multiplexed ion beam imaging (MIBI™ imaging)</oboInOwl:hasNarrowSynonym>
        <rdfs:label>Imaging mass cytometry</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Mass_cytometry#Imaging_Mass_Cytometry_(IMC)"/>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IMC/CyTOF is also Multiplexed immunostaining, however the readout is not (Immuno)fluorescence, but mass spectrometry.</skos:editorialNote>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NOTE: If we model Single-cell data aquisition, we cannot include Imaging mass cytometry (tissue) under Mass cytometry (single cell). But the &quot;pixel&quot; resolution here is subcellular, so we can say it is cytometry and therefore also single-cell analysis.</skos:editorialNote>
    </owl:Class>
    


