    <!-- http://edamontology.org/topic______Cryo_electron_microscopy -->

    <owl:Class rdf:about="http://edamontology.org/topic______Cryo_electron_microscopy">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_0611"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://edamontology.org/usable_for"/>
                <owl:someValuesFrom rdf:resource="http://edamontology.org/topics________027"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <_permanent_id rdf:resource="http://edamontology.org/topic_4017"/>
        <abbreviation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cryo-EM</abbreviation>
        <created_in>1.26</created_in>
        <oboInOwl:hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cryogenic electron microscopy is an electron microscopy technique for studying biomolecules and other structures at very low (cryogenic) temperature.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cryo electron microscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electron cryomicroscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cryoEM</oboInOwl:hasExactSynonym>
        <oboInOwl:savedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-05-03 Matúš Kalaš</oboInOwl:savedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cryogenic electron microscopy</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Cryogenic_electron_microscopy"/>
    </owl:Class>
    


