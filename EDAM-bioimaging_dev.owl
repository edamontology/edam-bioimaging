    <!-- http://edamontology.org/topic_3474 -->

    <owl:Class rdf:about="http://edamontology.org/topic_3474">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic_Statistics"/>
        <rdfs:subClassOf rdf:resource="http://edamontology.org/topic______Artificial_intelligence"/>
        <oboInOwl:hasDefinition>A topic concerning the application of artificial intelligence methods to algorithms, in order to create methods that can learn from data in order to generate an output, rather than relying on explicitly encoded information only.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ML</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Statistical learning</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Data mining</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/imaging"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:label>Machine learning</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Data_mining"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Machine_learning"/>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Statistical learning may either be considered as exact or narrow synonym (or even closely related) synonym of ML. On Wikipedia, https://en.wikipedia.org/wiki/Statistical_learning redirects to ML.</skos:editorialNote>
        <skos:editorialNote>odl EDAM main also had synonyms: Active learning, Ensembl learning, Kernel methods, Knowledge representation, Recommender system, Reinforcement learning, ...</skos:editorialNote>
    </owl:Class>
    


