        <oboInOwl:inSubset rdf:resource="http://edamontology.org/topics"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Differential interference contrast microscopy</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Differential_interference_contrast_microscopy"/>
    </owl:Class>
    


