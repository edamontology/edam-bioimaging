        <oboInOwl:hasExactSynonym>RNA-Seq quantitation</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/bio"/>
        <oboInOwl:inSubset rdf:resource="http://edamontology.org/operations"/>
        <rdfs:label>RNA-Seq quantification</rdfs:label>
    </owl:Class>
    


    <!-- http://edamontology.org/operation_3801 -->

    <owl:Class rdf:about="http://edamontology.org/operation_3801">
        <rdfs:subClassOf rdf:resource="http://edamontology.org/operation_3631"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://edamontology.org/has_input"/>
